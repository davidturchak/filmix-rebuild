# Signing keys — never commit private keys
*.keystore
*.jks
*.p12
*.idsig

# Third-party tooling (re-downloadable; jadx artifacts exceed GitHub's 100MB limit)
tools/

# APK under analysis — not ours to redistribute
*.apk

# Decompiler output — build artifacts, reproducible from the APK (see README)
apktool_out/
jadx_out/
extracted/

# Build output
build/
dist/
*.log

# Gradle / Android client
client/.gradle/
client/local.properties
client/**/build/
.kotlin/

# Release signing material — losing it breaks in-place updates, but it must
# not be published either. Back it up outside the repo.
client/keystore/
