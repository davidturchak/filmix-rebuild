\u044d\u043b\u043a\u0435\u0440","original_name":"Frank Welker"}],"directors":["\u041f\u0438\u0442\u0435\u0440 \u0410\u0432\u0430\u043d\u0437\u0438\u043d\u043e","\u0411\u0440\u044d\u0442 \u0425\u0430\u0430\u043b\u0430\u043d\u0434","\u0413\u0440\u0435\u0433\u0433 \u0412\u0430\u043d\u0446\u043e"],"poster":"http:\/\/thumbs.filmixapp.cyou\/posters\/1221\/thumbs\/w220\/novi-4w-futurama-2010_8975_0.jpg","short_story":"\u041d\u0435\u043b\u044c\u0437\u044f \u0437\u0430\u0431\u044b\u0432\u0430\u0442\u044c, \u0447\u0442\u043e \u00ab\u0424\u0443\u0442\u0443\u0440\u0430\u043c\u0430\u00bb - \u044d\u0442\u043e \u0435\u0449\u0435 \u0438 \u0444\u0430\u043d\u0442\u0430\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438-\u0441\u043c\u0435\u0448\u043d\u043e\u0439 \u044e\u043c\u043e\u0440. \u0421\u043e\u0441\u0442\u043e\u044f\u0449\u0438\u0439 \u0438\u0437 \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0439 \u043e\u0441\u0442\u0440\u043e\u0439 \u0441\u0430\u0442\u0438\u0440\u044b. \u0423\u0442\u043e\u043d\u0447\u0435\u043d\u043d\u044b\u0445 \u0448\u0443\u0442\u043e\u043a \u043d\u0430 \u0442\u0435\u043c\u044b, \u0431\u043b\u0438\u0437\u043a\u0438\u0435 \u043a \u0444\u0438\u0437\u0438\u043a\u0435, \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435 \u0438 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044e (\u043d\u0435 \u0434\u0430\u0440\u043e\u043c \u0432\u0435\u0434\u044c \u0414\u044d\u0432\u0438\u0434 \u041a\u043e\u044d\u043d \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043c\u0430\u0433\u0438\u0441\u0442\u0440\u043e\u043c \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043d\u044b\u0445 \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0439, \u0430 \u0434\u0440\u0443\u0433\u043e\u0439 \u0430\u0432\u0442\u043e\u0440 \u2013 \u041a\u0435\u043d \u041a\u0438\u043b\u0435\u0440, \u0442\u0430\u043a \u0438 \u0432\u043e\u043e\u0431\u0449\u0435 \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0434\u043e\u043a\u0442\u043e\u0440\u0441\u043a\u0443\u044e \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u0437\u0430 \u0440\u0430\u0431\u043e\u0442\u044b \u043f\u043e \u043f\u0440\u0438\u043a\u043b\u0430\u0434\u043d\u043e\u0439 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0435). \u0413\u0435\u0433\u043e\u0432, \u0431\u044c\u044e\u0449\u0438\u0445 \u043d\u0438\u0436\u0435 \u043f\u043e\u044f\u0441\u0430, \u043d\u0430\u043c\u0435\u043a\u043e\u0432 \u043d\u0430 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0435 \u043d\u0430\u0443\u0447\u043d\u043e-\u0444\u0430\u043d\u0442\u0430\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043c\u0438\u0444\u044b \u0438 \u0441\u043e\u0431\u044b\u0442\u0438\u044f 20 \u0432\u0435\u043a\u0430, \u043f\u0430\u0440\u043e\u0434\u0438\u0439 \u043d\u0430 \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0435 \u0444\u0438\u043b\u044c\u043c\u044b \u0438 \u0441\u0435\u0440\u0438\u0430\u043b\u044b, \u0438 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430 \u0441\u0430\u043c\u044b\u0445 \u0440\u0430\u0437\u043d\u044b\u0445 \u043f\u0440\u0438\u043a\u043e\u043b\u043e\u0432 \u0438 \u0441\u043c\u0435\u0448\u043d\u044b\u0445 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0439, \u0438\u0437-\u0437\u0430 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0432\u044b \u0431\u0443\u0434\u0435\u0442\u0435 \u0441\u043c\u0435\u044f\u0442\u044c\u0441\u044f \u0434\u043e \u0441\u043b\u0435\u0437 \u0438 \u0431\u0438\u0442\u044c\u0441\u044f \u0433\u043e\u043b\u043e\u0432\u043e\u0439 \u043e\u0431\u043e \u0432\u0441\u0435 \u0431\u043b\u0438\u0437\u043b\u0435\u0436\u0430\u0449\u0438\u0435 \u0442\u0432\u0435\u0440\u0434\u044b\u0435 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438. \u0418, \u043d\u0430\u043a\u043e\u043d\u0435\u0446, \u00ab\u0424\u0443\u0442\u0443\u0440\u0430\u043c\u0430\u00bb - \u044d\u0442\u043e \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e \u0444\u0430\u043d\u0442\u0430\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043d\u0430\u0431\u043e\u0440 \u0441\u0430\u043c\u044b\u0445 \u043a\u043e\u043b\u043e\u0440\u0438\u0442\u043d\u044b\u0445 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436\u0435\u0439, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043a\u043e\u0433\u0434\u0430-\u043b\u0438\u0431\u043e \u0432\u044b\u0445\u043e\u0434\u0438\u043b \u0438\u0437-\u043f\u043e\u0434 \u043a\u0438\u0441\u0442\u0438 \u0445\u0443\u0434\u043e\u0436\u043d\u0438\u043a\u0430-\u043c\u0443\u043b\u044c\u0442\u0438\u043f\u043b\u0438\u043a\u0430\u0442\u043e\u0440\u0430. \u041d\u043e \u043e\u0431\u043e \u0432\u0441\u0435\u043c \u043f\u043e \u043f\u043e\u0440\u044f\u0434\u043a\u0443. \u041d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0441\u043b\u043e\u0432 \u043e \u0441\u044e\u0436\u0435\u0442\u0435. \u0412\u0441\u0435 \u043d\u0430\u0447\u0438\u043d\u0430\u0435\u0442\u0441\u044f \u0441 \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u043f\u0440\u043e\u0441\u0442\u043e\u0439 \u0440\u0430\u0437\u043d\u043e\u0441\u0447\u0438\u043a \u043f\u0438\u0446\u0446\u044b  \u043f\u043e \u0438\u043c\u0435\u043d\u0438 \u0424\u0438\u043b\u0438\u043f\u043f \u0414\u0436\u0435\u0439 \u0424\u0440\u0430\u0439, \u043f\u0440\u043e\u0436\u0438\u0432\u0430\u044e\u0449\u0438\u0439  \u0432 \u041d\u044c\u044e-\u0419\u043e\u0440\u043a\u0435 \u0432 \u0441\u0430\u043c\u043e\u043c-\u0441\u0430\u043c\u043e\u043c \u043a\u043e\u043d\u0446\u0435  \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u043e\u0433\u043e \u0432\u0435\u043a\u0430, \u043f\u043e \u0447\u0438\u0441\u0442\u043e\u0439 \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u043e\u0441\u0442\u0438, \u0432\u044b\u0437\u0432\u0430\u043d\u043d\u043e\u0439 \u0435\u0433\u043e \u043d\u0435\u043f\u0440\u043e\u0445\u043e\u0434\u0438\u043c\u043e\u0439 \u0436\u0438\u0442\u0435\u0439\u0441\u043a\u043e\u0439  \u0433\u043b\u0443\u043f\u043e\u0441\u0442\u044c\u044e, \u043f\u043e\u043f\u0430\u0434\u0430\u0435\u0442 \u0432 \u043a\u0440\u0438\u043e\u0433\u0435\u043d\u043d\u0443\u044e \u043a\u0430\u043c\u0435\u0440\u0443 \u0438 \u043e\u0441\u0442\u0430\u0435\u0442\u0441\u044f \u0432 \u0432\u0438\u0434\u0435 \u0437\u0430\u043c\u043e\u0440\u043e\u0436\u0435\u043d\u043d\u043e\u0439 \u0441\u043e\u0441\u0443\u043b\u044c\u043a\u0438 \u0446\u0435\u043b\u044b\u0445 \u0442\u044b\u0441\u044f\u0447\u0443 \u043b\u0435\u0442. \u041a\u043e\u0433\u0434\u0430 \u0436\u0435 \u0435\u0433\u043e \u043d\u0430\u043a\u043e\u043d\u0435\u0446-\u0442\u043e \u0440\u0430\u0437\u043c\u043e\u0440\u043e\u0437\u0438\u043b\u0438, \u0424\u0440\u0430\u0439 \u043f\u043e\u043d\u044f\u043b, \u0447\u0442\u043e \u043e\u0447\u0443\u0442\u0438\u043b\u0441\u044f \u0432 \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e \u0434\u0440\u0443\u0433\u043e\u043c \u0432\u0440\u0435\u043c\u0435\u043d\u0438! \u0412 \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u043e\u043c \u0432\u0435\u043a\u0435 \u043d\u0430 \u043c\u0435\u0441\u0442\u0435 \u041d\u044c\u044e-\u0419\u043e\u0440\u043a\u0430 \u0443\u0436\u0435 \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d \u041d\u044c\u044e-\u041d\u044c\u044e-\u0419\u043e\u0440\u043a, \u0417\u0435\u043c\u043b\u044f \u043f\u0435\u0440\u0435\u0436\u0438\u043b\u0430 \u0438 \u0433\u043b\u043e\u0431\u0430\u043b\u044c\u043d\u043e\u0435 \u043f\u043e\u0442\u0435\u043f\u043b\u0435\u043d\u0438\u0435, \u0438 \u044f\u0434\u0435\u0440\u043d\u0443\u044e \u0437\u0438\u043c\u0443. \u041f\u043e\u043b\u0435\u0442\u044b \u0432 \u043a\u043e\u0441\u043c\u043e\u0441 \u0441\u0442\u0430\u043b\u0438 \u0441\u0442\u043e\u043b\u044c \u0436\u0435 \u043e\u0431\u044b\u0434\u0435\u043d\u043d\u044b\u043c, \u043a\u0430\u043a \u043f\u043e\u0435\u0437\u0434\u043a\u0430 \u043d\u0430 \u0442\u0430\u043a\u0441\u0438 \u043a \u0431\u0430\u0431\u0443\u0448\u043a\u0435 \u0432 \u043f\u0440\u0438\u0433\u043e\u0440\u043e\u0434, \u0430 \u0440\u0430\u0437\u0443\u043c\u043d\u044b\u0435 \u0440\u043e\u0431\u043e\u0442\u044b \u0438 \u0438\u043d\u043e\u043f\u043b\u0430\u043d\u0435\u0442\u044f\u043d\u0435 \u0441\u0442\u0430\u043b\u0438 \u0441\u0442\u043e\u043b\u044c \u0436\u0435 \u043f\u0440\u0438\u0432\u044b\u0447\u043d\u044b, \u0441\u043a\u043e\u043b\u044c \u044f\u043f\u043e\u043d\u0441\u043a\u0438\u0435 \u0442\u0443\u0440\u0438\u0441\u0442\u044b \u0432 \u043a\u0430\u0436\u0434\u043e\u0439 \u0442\u043e\u0447\u043a\u0435 \u0437\u0435\u043c\u043d\u043e\u0433\u043e \u0448\u0430\u0440\u0430 \u0432 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u043e\u043c \u0432\u0435\u043a\u0435. \u0410 \u0432\u0441\u0435 \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u043e\u0435 \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u043e\u0441\u044c \u043a\u0440\u0430\u0439\u043d\u0435 \u043c\u0430\u043b\u043e. \u0421\u043e\u0445\u0440\u0430\u043d\u0438\u043b\u0438\u0441\u044c \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u044b\u0435 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b, \u0442\u0430\u043a\u0438\u0435 \u043a\u0430\u043a \u044d\u043a\u043e\u043b\u043e\u0433\u0438\u044f, \u0431\u044e\u0440\u043e\u043a\u0440\u0430\u0442\u0438\u044f, \u043f\u0440\u0435\u0441\u0442\u0443\u043f\u043d\u043e\u0441\u0442\u044c (\u043c\u0430\u0444\u0438\u043e\u0437\u043d\u044b\u0435 \u043a\u043b\u0430\u043d\u044b \u0442\u0435\u043f\u0435\u0440\u044c \u0441\u043e\u0437\u0434\u0430\u044e\u0442\u0441\u044f, \u0432 \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u043c, \u0440\u043e\u0431\u043e\u0442\u0430\u043c\u0438) \u0438 \u0440\u0430\u0441\u043e\u0432\u044b\u0435 \u043f\u0440\u0435\u0434\u0440\u0430\u0441\u0441\u0443\u0434\u043a\u0438 (\u043c\u0443\u0442\u0430\u043d\u0442\u044b, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043f\u0440\u044f\u0447\u0443\u0442\u0441\u044f \u043e\u0442 \u0432\u0441\u0435\u0433\u043e \u043c\u0438\u0440\u0430 \u0432 \u043a\u0430\u043d\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f\u0445, \u0430 \u0431\u0435\u0437\u0440\u0430\u0431\u043e\u0442\u043d\u044b\u0435 \u043a\u0438\u0431\u043e\u0440\u0433\u0438 \u043d\u0435 \u0445\u043e\u0442\u044f\u0442 \u043d\u0438\u0447\u0435\u0433\u043e \u0434\u0435\u043b\u0430\u0442\u044c \u0438 \u0436\u0438\u0432\u0443\u0442 \u043d\u0430 \u043f\u043e\u0441\u043e\u0431\u0438\u044f \u0432 \u0433\u0435\u0442\u0442\u043e). \u0422\u0435\u043b\u0435\u0432\u0438\u0434\u0435\u043d\u0438\u0435 \u043f\u0435\u0440\u0435\u043f\u043e\u043b\u043d\u0435\u043d\u043e \u0440\u0435\u043a\u043b\u0430\u043c\u043e\u0439, \u0418\u043d\u0442\u0435\u0440\u043d\u0435\u0442 \u2013 \u043f\u043e\u0440\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u0435\u0439, \u043d\u0438\u043a\u0443\u0434\u0430 \u043d\u0435 \u0434\u0435\u043b\u0438\u0441\u044c \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u0430\u043b\u043a\u043e\u0433\u043e\u043b\u0435\u043c \u0438 \u043d\u0430\u0440\u043a\u043e\u0442\u0438\u043a\u0430\u043c\u0438.\u2026 \u0412 \u043e\u0431\u0449\u0435\u043c, \u0424\u0440\u0430\u0439 \u0438\u0437 \u043f\u0440\u043e\u0448\u043b\u043e\u0433\u043e \u0432\u043f\u043e\u043b\u043d\u0435 \u043c\u043e\u0436\u0435\u0442 \u0437\u0434\u0435\u0441\u044c \u043f\u043e\u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c \u0441\u0435\u0431\u044f \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e, \u043a\u0430\u043a \u0434\u043e\u043c\u0430. \u0422\u0435\u043c \u0431\u043e\u043b\u0435\u0435, \u0447\u0442\u043e \u043a\u0440\u0430\u0441\u0430\u0432\u0438\u0446\u0430 \u041b\u0438\u043b\u0430, \u0438\u043d\u0441\u043f\u0435\u043a\u0442\u043e\u0440 \u043f\u043e \u0432\u043d\u0435\u0434\u0440\u0435\u043d\u0438\u044e \u0447\u0438\u043f\u043e\u0432, \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u044e\u0449\u0438\u0445 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u044e \u0437\u0435\u043c\u043d\u044b\u0445 \u0433\u0440\u0430\u0436\u0434\u0430\u043d, \u0441\u043e\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044f \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u044c \u0435\u0433\u043e \u043d\u0430 \u0442\u0443 \u0436\u0435 \u0441\u0430\u043c\u0443\u044e \u0441\u043a\u0443\u0447\u043d\u0443\u044e \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c \u043a\u0443\u0440\u044c\u0435\u0440\u0430, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043d\u0430\u0434\u043e\u0435\u043b\u0430 \u0424\u0440\u0430\u044e \u0435\u0449\u0435 \u0432 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u043e\u043c \u0432\u0435\u043a\u0435. \u0422\u0430\u043a \u0447\u0442\u043e \u043e\u043d \u0441\u0431\u0435\u0433\u0430\u0435\u0442, \u0437\u043d\u0430\u043a\u043e\u043c\u0438\u0442\u0441\u044f \u0441 \u0440\u043e\u0431\u043e\u0442\u043e\u043c \u0411\u0435\u043d\u0434\u0435\u0440\u043e\u043c, \u0438 \u043a\u0430\u043a-\u0442\u043e \u043d\u0435\u043e\u0436\u0438\u0434\u0430\u043d\u043d\u043e \u0442\u0440\u043e\u0438\u0446\u0430 \u0424\u0440\u0430\u0439-\u0411\u0435\u043d\u0434\u0435\u0440-\u041b\u0438\u043b\u0430 \u043d\u0430\u0447\u0438\u043d\u0430\u044e\u0442 \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u0432 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0438 \u00ab\u041c\u0435\u0436\u043f\u043b\u0430\u043d\u0435\u0442\u043d\u044b\u0439 \u044d\u043a\u0441\u043f\u0440\u0435\u0441\u0441\u00bb, \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u0430\u0449\u0438\u0439 \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u043c\u0443 \u0436\u0438\u0432\u043e\u043c\u0443 \u0440\u043e\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u0443 \u0433\u043e\u0441\u0442\u044f \u0438\u0437 \u043f\u0440\u043e\u0448\u043b\u043e\u0433\u043e \u2013 \u0433\u0435\u043d\u0438\u044e \u0438 \u0441\u0443\u043c\u0430\u0441\u0448\u0435\u0434\u0448\u0435\u043c\u0443 \u0425\u044c\u044e\u0431\u0435\u0440\u0442\u0443 \u0424\u0430\u0440\u043d\u0441\u0432\u043e\u0440\u0442\u0443. \u041b\u0438\u043b\u0430, \u043a\u0430\u043a \u0434\u0438\u043f\u043b\u043e\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u043f\u0438\u043b\u043e\u0442, \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f \u043a\u043e\u043c\u0430\u043d\u0434\u0438\u0440\u043e\u043c \u043a\u043e\u0440\u0430\u0431\u043b\u044f, \u0411\u0435\u043d\u0434\u0435\u0440\u0443 \u0434\u043e\u0441\u0442\u0430\u0435\u0442\u0441\u044f \u0440\u043e\u043b\u044c \u0448\u0435\u0444-\u043f\u043e\u0432\u0430\u0440\u0430, \u043d\u0443 \u0430 \u0424\u0440\u0430\u044e \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442 \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c \u2026 \u043a\u0443\u0440\u044c\u0435\u0440\u0430. \u0421\u043e\u0437\u0434\u0430\u0442\u0435\u043b\u0438 \u0441\u0435\u0440\u0438\u0430\u043b\u0430 \u00ab\u0424\u0443\u0442\u0443\u0440\u0430\u043c\u0430\u00bb \u0434\u0430\u0436\u0435 \u043d\u0435 \u0441\u043e\u0431\u0438\u0440\u0430\u044e\u0442\u0441\u044f \u043e\u0441\u043f\u0430\u0440\u0438\u0432\u0430\u0442\u044c \u0442\u0435\u0437\u0438\u0441 \u00ab\u043e\u0442 \u0441\u0443\u0434\u044c\u0431\u044b \u043d\u0435 \u0443\u0439\u0434\u0435\u0448\u044c!\u00bb. \u0410 \u0434\u0430\u043b\u044c\u0448\u0435 \u2013 \u0434\u0430\u043b\u044c\u0448\u0435 \u043d\u0430\u0447\u0438\u043d\u0430\u044e\u0442\u0441\u044f \u043f\u0440\u0438\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f. \u041f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440 \u0424\u0430\u0440\u043d\u0441\u0432\u043e\u0440\u0442 \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0442 \u0441\u0432\u043e\u0438\u0445 \u043f\u043e\u0434\u0447\u0438\u043d\u0435\u043d\u043d\u044b\u0445 \u0432 \u0441\u0430\u043c\u044b\u0435 \u0440\u0430\u0437\u043d\u043e\u043e\u0431\u0440\u0430\u0437\u043d\u044b\u0435 \u043c\u0438\u0441\u0441\u0438\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0431\u0443\u0434\u0443\u0442 \u043e\u043f\u0430\u0441\u043d\u044b, \u0433\u043b\u0443\u043f\u044b, \u0438 \u0441\u0430\u043c\u043e\u0435 \u0433\u043b\u0430\u0432\u043d\u043e\u0435, \u043d\u0435\u0438\u043c\u043e\u0432\u0435\u0440\u043d\u043e \u0441\u043c\u0435\u0448\u043d\u044b! \u041a\u0440\u043e\u043c\u0435 \u0437\u0430\u0434\u0430\u043d\u0438\u0439 \u043f\u043e \u0434\u043e\u0431\u044b\u0447\u0435 \u0438 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438 \u0441\u0430\u043c\u044b\u0445 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u044b\u0445 \u0432 \u0413\u0430\u043b\u0430\u043a\u0442\u0438\u043a\u0435 \u0442\u043e\u0432\u0430\u0440\u043e\u0432, \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u0430\u043c \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0438 \u00ab\u041c\u0435\u0436\u043f\u043b\u0430\u043d\u0435\u0442\u043d\u044b\u0439 \u044d\u043a\u0441\u043f\u0440\u0435\u0441\u0441\u00bb \u043f\u0440\u0438\u0434\u0435\u0442\u0441\u044f \u043d\u0435\u043e\u0434\u043d\u043e\u043a\u0440\u0430\u0442\u043d\u043e \u0441\u043f\u0430\u0441\u0430\u0442\u044c \u043c\u0438\u0440 \u043a\u0430\u043a \u043e\u0442 \u0432\u043d\u0435\u0448\u043d\u0438\u0445 \u0443\u0433\u0440\u043e\u0437, \u0442\u0430\u043a \u0438 \u043e\u0442 \u0441\u0430\u043c\u0438\u0445 \u0441\u0435\u0431\u044f. \u041e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u0447\u0430\u0441\u0442\u043e \u043f\u043b\u0430\u043d\u0435\u0442\u0435 \u0431\u0443\u0434\u0443\u0442 \u0443\u0433\u0440\u043e\u0436\u0430\u0442\u044c \u0431\u0435\u0437\u0443\u043c\u043d\u044b\u0435 \u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u044b \u0424\u0430\u0440\u043d\u0441\u0432\u043e\u0440\u0442\u0430 \u0438 \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0435 \u044d\u0433\u043e \u0440\u043e\u0431\u043e\u0442\u0430 \u0411\u0435\u043d\u0434\u0435\u0440\u0430.","player_links":{"movie":[{"link":"https:\/\/nl101.werkecdn.me\/s\/FHkRBcmjgnbeduHKdqxSYoFUFBQUFBQUFBQUFBUmRaVUdCUUJV.x1vW8KA1n_NVYw6trv91fUPr8j-G73-7b96jKA\/abuse_[,,,,480,].mp4","translation":"\u0417\u0430\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u0430\u043d\u043e \u043f\u0440\u0430\u0432\u043e\u043e\u0431\u043b\u0430\u0434\u0430\u0442\u0435\u043b\u0435\u043c!","wd":null}],"playlist":[],"trailer":[]},"kp_rating":8.195,"kp_votes":329750,"imdb_rating":8.5,"imdb_votes":278000,"serial_stats":{"status":1,"comment":"\u0411\u0443\u0434\u0435\u0442 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0435\u043d\u0438\u0435 \u0441\u0435\u0440\u0438\u0430\u043b\u0430","status_tex