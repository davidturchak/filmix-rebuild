<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Self-update: hands the downloaded APK to the system package installer,
         which still asks the user to confirm. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Voice search drives SpeechRecognizer directly; the intent route opens
         the TV search overlay without ever engaging the microphone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- The mic lives in the remote, and the TV declares no mic feature —
         requiring it would filter the app off the devices where voice matters. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- On targetSdk 30+ other packages are invisible unless declared; without
         this the external-player list in Config would always come back empty. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" android:mimeType="video/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" android:mimeType="video/*" />
        </intent>
    </queries>

    <!-- The Leanback launcher draws a 320x180 banner, never the square icon,
         and leaves a blank tile without one. Google TV's launcher uses the
         adaptive icon instead, which is why the app looked fine only there. -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/banner"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.FilmixClient">

        <!-- Declared on the activity as well as the application. The two are
             meant to be equivalent — ComponentInfo.loadBanner() falls back from
             one to the other — but a launcher that reads the activity's banner
             field directly sees 0 and draws a blank tile, which is what a TCL
             Leanback launcher did with the application-level banner alone. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:banner="@drawable/banner"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.FilmixClient">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
